
---
import Layout from "../../layouts/Layout.astro";
import "leaflet/dist/leaflet.css";
---

<Layout title="Carte des établissements | Penguin">
  <main class="page-shell">
    <div class="page-heading">
      <h1>Carte des établissements</h1>
      <p>Localisation des établissements en France.</p>
    </div>

    <div id="map" aria-label="Carte interactive des établissements en France"></div>
  </main>
</Layout>

<style>
  #map {
    width: 100%;
    height: 600px;
    margin-top: 30px;
    border-radius: 16px;
    z-index: 0;
  }
</style>
 
<script>
  import L from "leaflet";
  import listeEtablissements from "../../assets/listeEtablissements.json";

  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19
  }).addTo(map);

  listeEtablissements.forEach((etablissement) => {
    if (etablissement.lat != null && etablissement.lon != null) {
      L.marker([etablissement.lat, etablissement.lon])
        .addTo(map)
        .bindPopup(etablissement.name);
    }
  });

</script>
