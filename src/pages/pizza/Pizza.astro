---
import PlotFigure from "../../components/PlotFigure.astro";
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import pizzas from "../../assets/pizza.json";
---

<Layout title="Pizza | Pizza Field Notes">
  <main class="page-shell">
    <section class="species-hero">
      <div>
        <h1 class="home-title">Pizza</h1>
      </div>

      <div class="rounded-2xl border border-white/70 bg-white/60 p-3 shadow-xl shadow-violet-100">
        <PlotFigure
          options={{
            marginLeft: 58,
            marginBottom: 48,

            x: { label: "Prix (€)" },
            y: { label: "Nombre de commandes" },

            marks: [
              Plot.dot(pizzas, {
                x: "price",
                y: "orders",
                fill: "category",
                r: 4,
                fillOpacity: 0.72,
              }),
            ],
          }}
        />
      </div>
    </section>
  </main>
</Layout>