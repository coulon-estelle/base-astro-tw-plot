---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const speciesCounts = ["Adelie", "Chinstrap", "Gentoo"].map((species) => ({
  species,
  count: penguins.filter((penguin) => penguin.species === species).length,
}));
---

<Layout title="Penguins | Penguin Field Notes">
  <main class="page-shell">
    <section class="species-hero">
      <div>
        <h1 class="home-title">Penguins · trois espèces</h1>
      </div>
      <div class="rounded-2xl border border-white/70 bg-white/60 p-3 shadow-xl shadow-violet-100">
        <PlotFigure
          options={{
            marginLeft: 58,
            marginBottom: 48,
            x: { label: "Espèce" },
            y: { label: "Nombre de penguins", grid: true },
            marks: [
              Plot.barY(speciesCounts, {
                x: "species",
                y: "count",
                fill: "species",
              }),
            ],
          }}
        />
      </div>
    </section>
  </main>
</Layout>
