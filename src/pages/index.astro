---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout title="Accueil | Penguin Field Notes">
  <main class="page-shell">
    <section class="species-hero">
      <div>
        <h1 class="home-title">Carnet de terrain · Antarctique</h1>
      </div>
      <div class="rounded-2xl border border-white/70 bg-white/60 p-3 shadow-xl shadow-violet-100">
        <PlotFigure
          options={{
            marginLeft: 58,
            marginBottom: 48,
            x: { label: "Longueur du culmen (mm)" },
            y: { label: "Profondeur du culmen (mm)" },
            marks: [
              Plot.dot(penguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                fill: "species",
                r: 4,
                fillOpacity: 0.72,
              }),
            ],
          }}
        />
      </div>
    </section>
  </main>
</Layout>
