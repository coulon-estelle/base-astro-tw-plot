---
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import ActiveMenu from "../../components/ActiveMenu.astro";
import Layout from "../../layouts/Layout.astro";
import penguins from "../../assets/penguins.json";

const speciesList = [...new Set(penguins.map((penguin) => penguin.species))];

const colors = ["#e11d48", "#7c3aed", "#0891b2"];
const panelClasses = [
  "border-rose-200 bg-rose-50",
  "border-violet-200 bg-violet-50",
  "border-cyan-200 bg-cyan-50"
];
const titleClasses = ["text-rose-800", "text-violet-800", "text-cyan-800"];

---


<Layout title="Vue d'ensemble | Penguin Field Notes">
	<main class="page-shell">
		<div class="page-heading">
			<h1 class="eyebrow">Atlas comparatif · 03 espèces</h1>
		</div>
		<label class="species-slider-menu">
			<span class="sr-only">Choisir un graphique</span>
			<select id="species-anchor" class="species-anchor-select" aria-label="Accès rapide aux graphiques">
				{speciesList.map((species) => (
  <option value={species.toLowerCase()}>
    {species}
  </option>
))}
			</select>
		</label>
		<section id="species-slider" class="species-slider" aria-label="Graphiques par espèce">
			{speciesList.map((species, index) => (
  <GraphicSpecies
    id={species.toLowerCase()}
    title={species}
    data={penguins.filter((penguin) => penguin.species === species)}
    color={colors[index % colors.length]}
    panelClass={panelClasses[index % panelClasses.length]}
    titleClass={titleClasses[index % titleClasses.length]}
  />
))}	
		</section>
	</main>
</Layout>

<ActiveMenu />
