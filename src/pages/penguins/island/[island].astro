---
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../../assets/penguins.json";

export function getStaticPaths() {
  const islands = [...new Set(penguins.map((penguin) => penguin.island))];

  return islands.map((island) => ({
    params: { island: island.toLowerCase() }
  }));
}

const { island } = Astro.params;

const filteredPenguins = penguins.filter(
  (penguin) => penguin.island.toLowerCase() === island
);

const islandName = [...new Set(penguins.map((penguin) => penguin.island))]
  .find((name) => name.toLowerCase() === island) ?? island;

const speciesCount = new Set(filteredPenguins.map((penguin) => penguin.species)).size;

const averageMass = Math.round(
  filteredPenguins
    .filter((penguin) => penguin.body_mass_g !== null)
    .reduce((sum, penguin) => sum + penguin.body_mass_g, 0) /
  filteredPenguins.filter((penguin) => penguin.body_mass_g !== null).length
);

const validPenguins = filteredPenguins.filter(
  (penguin) =>
    penguin.culmen_length_mm !== null &&
    penguin.culmen_depth_mm !== null
);
---

<Layout title={`${islandName} | Penguin Field Notes`}>
  <main class="island-detail">

    <a href="/penguins/island" class="back-link">
      ← Retour aux îles
    </a>

    <header class="detail-heading">
      <span class="eyebrow-detail">PENGUIN FIELD NOTES — EXPLORATION</span>
      <h1>Île de {islandName}</h1>
      <p>
        Découvrez les caractéristiques morphologiques des pingouins
        observés sur cette île.
      </p>
    </header>

    <section class="stats-grid">
      <div class="stat-card">
        <span>INDIVIDUS OBSERVÉS</span>
        <strong>{filteredPenguins.length}</strong>
        <p>Pingouins recensés</p>
      </div>

      <div class="stat-card">
        <span>ESPÈCES PRÉSENTES</span>
        <strong>{speciesCount}</strong>
        <p>Espèces différentes</p>
      </div>

      <div class="stat-card">
        <span>MASSE MOYENNE</span>
        <strong>{averageMass} g</strong>
        <p>Masse corporelle</p>
      </div>
    </section>

    <section class="chart-card">
      <div class="chart-heading">
        <div>
          <span class="chart-label">ANALYSE MORPHOLOGIQUE</span>
          <h2>Comparaison des mensurations</h2>
          <p>
            Relation entre la longueur et la profondeur du culmen,
            selon l'espèce.
          </p>
        </div>
      </div>

      <div class="chart-container">
        <PlotFigure
          options={{
            width: 760,
            height: 430,
            marginTop: 35,
            marginRight: 35,
            marginBottom: 65,
            marginLeft: 75,
            style: {
              background: "transparent",
              fontSize: "12px",
              fontFamily: "Arial, sans-serif"
            },
            x: {
              label: "Longueur du culmen (mm)",
              grid: true
            },
            y: {
              label: "Profondeur du culmen (mm)",
              grid: true
            },
            color: {
              legend: true,
              scheme: "tableau10"
            },
            marks: [
              Plot.dot(validPenguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                fill: "species",
                r: 5,
                fillOpacity: 0.8,
                stroke: "white",
                strokeWidth: 1
              })
            ]
          }}
        />
      </div>
    </section>

  </main>
</Layout>

<style>
  .island-detail {
    max-width: 1150px;
    margin: 0 auto;
    padding: 65px 30px 110px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 45px;
    font-size: 14px;
    font-weight: 600;
    color: #7c3aed;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .detail-heading {
    margin-bottom: 45px;
  }

  .eyebrow-detail,
  .chart-label {
    color: #7c3aed;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .detail-heading h1 {
    font-family: Georgia, serif;
    font-size: clamp(38px, 5vw, 62px);
    font-weight: 400;
    line-height: 1.15;
    color: #29223d;
    margin: 15px 0 20px;
  }

  .detail-heading p {
    max-width: 580px;
    color: #777084;
    font-size: 15px;
    line-height: 1.8;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 35px;
  }

  .stat-card {
    background: #fff;
    border: 1px solid #e9e3f4;
    border-radius: 20px;
    padding: 25px;
  }

  .stat-card span {
    color: #9389a4;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .stat-card strong {
    display: block;
    margin: 14px 0 5px;
    font-family: Georgia, serif;
    font-size: 35px;
    font-weight: 400;
    color: #29223d;
  }

  .stat-card p {
    color: #9389a4;
    font-size: 12px;
  }

  .chart-card {
    background: #fff;
    border: 1px solid #e9e3f4;
    border-radius: 24px;
    padding: 35px;
    box-shadow: 0 12px 40px rgba(41, 34, 61, 0.04);
  }

  .chart-heading {
    margin-bottom: 35px;
  }

  .chart-heading h2 {
    font-family: Georgia, serif;
    font-size: 27px;
    font-weight: 400;
    color: #29223d;
    margin: 10px 0;
  }

  .chart-heading p {
    font-size: 13px;
    color: #9389a4;
    line-height: 1.7;
  }

  .chart-container {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    max-width: 100%;
  }

  .chart-container :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .island-detail {
      padding: 35px 20px 70px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .chart-card {
      padding: 20px;
    }

    .chart-container {
      justify-content: flex-start;
    }
  }
</style>
