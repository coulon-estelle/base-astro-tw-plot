---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const species = [
  { value: "/", label: "Simple" },
  { value: "/species/Penguins", label: "Penguins · JSON" },
  { value: "/species/Allspecies", label: "Vue d'ensemble" },
  { value: "/species/Allspeciestabs", label: "Vue d'ensemble avec onglets" },
  { value: "/species/Adelie", label: "Adelie" },
  { value: "/species/Chinstrap", label: "Chinstrap" },
  { value: "/species/Gentoo", label: "Gentoo" },
  { value: "/species/Penguinsselect", label: "Sélection d'espèces" },
  { value: "/species/Selectislandsex", label: "Sélection d'espèces, îles et sexes" },
  { value: "/penguins/specie", label: "Espèces · pages dynamiques" },
  { value: "/penguins/island", label: "Îles · pages dynamiques" },
  { value: "/penguins/sex", label: "Sexes · pages dynamiques" },
  { value: "/leaflet", label: "Carte Leaflet" },
{ value: "/geojson", label: "Carte GeoJSON" },
];

const currentSpecies =
  species.find((item) => item.value === currentPath)?.value ??
  (currentPath.startsWith("/penguins/specie/") ? "/penguins/specie" :
   currentPath.startsWith("/penguins/island/") ? "/penguins/island" :
   currentPath.startsWith("/penguins/sex/") ? "/penguins/sex" : "/");

const pizzas = [
  { value: "/pizza/Pizza", label: "Pizza" }
];

const currentPizza = pizzas.find(
  (item) => item.value === currentPath
)?.value ?? "";
---

<nav class="site-nav" aria-label="Navigation principale">
  <a class="brand" href="/" aria-label="Penguin, accueil">
    <strong>Penguin</strong>
  </a>

  <label class="species-menu">
    <span class="sr-only">Choisir une page Penguins</span>

    <select
      id="species"
      class="species-select rounded-b-xl border border-violet-200 bg-white px-4 py-3 text-gray-700 shadow-sm outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-200"
    >
      {species.map((item) => (
        <option
          value={item.value}
          selected={currentSpecies === item.value}
        >
          {item.label}
        </option>
      ))}
    </select>
  </label>

  <label class="species-menu">
    <span class="sr-only">Choisir une page pizza</span>

    <select id="pizza" class="species-select">
      <option value="" selected={currentPizza === ""}>
        Choisir Pizza
      </option>

      {pizzas.map((item) => (
        <option
          value={item.value}
          selected={currentPizza === item.value}
        >
          {item.label}
        </option>
      ))}
    </select>
  </label>
</nav>

<script>
  document.querySelector("#species")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;
    window.location.pathname = value;
  });

  document.querySelector("#pizza")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;

    if (value) {
      window.location.pathname = value;
    }
  });
</script>
